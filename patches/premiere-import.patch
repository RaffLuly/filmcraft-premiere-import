+                            }
+                            effects.push(effect);
+                        }
+                    }
+                    if kind == "caption" {
+                        let block = referred(descendant(item, "BlockVectorItem"), &ids, "ObjectRef");
+                        if let Some(block) = block {
+                            spend(&mut work_left, block)?;
+                        }
+                        text = block.and_then(|b| child_text(b, "FormattedTextData")).and_then(caption_text);
