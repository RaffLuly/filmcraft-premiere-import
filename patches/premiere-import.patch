+                        // It is a native canvas, not a missing filesystem asset.
+                        media_path = None;
+                        nested_sequence = None;
+                    }
+                    if media_path.is_none()
+                        && nested_sequence.is_none()
+                        && generated.is_none()
+                        && adjustment_layer.is_none()
+                        && kind != "caption"
+                        && !graphic
+                        && text.is_none()
+                    {
+                        let named_sequence = names.get(label.as_str()).copied().flatten();
