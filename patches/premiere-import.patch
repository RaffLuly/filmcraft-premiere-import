+    let mp3_alias = matches!(ext.as_str(), "mpeg" | "mpg") && has_mp3_frames(&bytes);
+    if !mp3_alias && !matches!(ext.as_str(), "mp3" | "mp2" | "aac" | "flac" | "ogg" | "oga" | "aif" | "aiff" | "aifc") {
