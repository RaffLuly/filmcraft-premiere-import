+                s.info.name = name.to_string();
+                Arc::new(s) as SharedSource
+            })
+            .map_err(Into::into),
+    )
+}
+
+fn has_mp3_frames(bytes: &[u8]) -> bool {
+    let start = id3v2_len(bytes);
+    let Some(first) = bytes.get(start..).and_then(|b| craft_audio::mpa::parse_header(b).ok()) else { return false };
+    if first.layer != 3 || first.frame_bytes == 0 {
+        return false;
+    }
+    let next = start.checked_add(first.frame_bytes).and_then(|p| bytes.get(p..)).and_then(|b| craft_audio::mpa::parse_header(b).ok());
+    next.is_some_and(|h| h.layer == 3 && h.sample_rate == first.sample_rate && h.frame_bytes > 0)
 }
 
