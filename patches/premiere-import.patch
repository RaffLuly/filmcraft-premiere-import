+                    }
+                    let source_out = match clip.and_then(|s| value(s, "OutPoint")) {
+                        Some(raw) => ticks(Some(raw), Tick::ZERO)?,
+                        None => Tick(source_in.0.checked_add((end.0 - start.0).max(0)).ok_or_else(|| error("source time overflow"))?),
