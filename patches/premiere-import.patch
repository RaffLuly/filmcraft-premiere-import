+                    let adjustment_layer = master
+                        .filter(|_| kind == "video")
+                        .filter(|m| child_text(*m, "IsAdjustmentLayer").is_some_and(|v| v.eq_ignore_ascii_case("true") || v == "1"))
+                        .and_then(|m| m.attribute("ObjectUID"))
+                        .map(str::to_string);
+                    let mut synthetic = None;
+                    match &generated {
+                        _ if adjustment_layer.is_some() => {}
