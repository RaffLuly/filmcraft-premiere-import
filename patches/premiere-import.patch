+/// A dip with a missing side is a single fade over the full transition duration.
+pub(crate) fn dip_progress(p: f32, from: bool, to: bool) -> f32 {
+    match (from, to) {
+        (true, false) => p * 0.5,
+        (false, true) => 0.5 + p * 0.5,
+        _ => p,
+    }
+}
