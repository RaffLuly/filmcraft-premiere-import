+<VideoSequenceSource ObjectID="sequence-source"><SequenceSource><Sequence ObjectURef="sequence"/></SequenceSource></VideoSequenceSource>
+<ClipProjectItem ObjectUID="black-item"><ProjectItem><Name>Vídeo negro</Name></ProjectItem><MasterClip ObjectURef="black-master"/></ClipProjectItem>
+<MasterClip ObjectUID="black-master"><Clips><Clip Index="0" ObjectRef="black-clip"/></Clips><Name>Vídeo negro</Name></MasterClip>
+<VideoClip ObjectID="black-clip"><Clip><Source ObjectRef="black-source"/></Clip></VideoClip>
+<VideoMediaSource ObjectID="black-source"><MediaSource><Media ObjectURef="black-media"/></MediaSource></VideoMediaSource>
+<Media ObjectUID="black-media"><Title>Vídeo negro</Title><FilePath>{black}</FilePath></Media></PremiereData>"#
+            ),
+        )
+    }
+    #[test]
+    fn bins_and_their_items_are_imported() {
+        let (fragment, tree, report) = import(bins_fixture().as_bytes(), &ImportOptions::default(), None).unwrap();
+        let names: Vec<_> = tree.bins.iter().map(|b| (b.name.as_str(), b.parent)).collect();
+        assert_eq!(names, [("Footage", None), ("Selects", Some(0)), ("Unused", None)], "a bin listing its parent is read once");
+        let p = &fragment.project;
+        let bin_of = |id: filmcraft_project::ItemId| p.root.parent_of(id).and_then(|b| p.root.find_bin(b)).map(|b| b.name.clone());
+        let clip = &p.sequence(fragment.sequences[0]).unwrap().video_tracks[0].items[0];
+        assert_eq!(bin_of(clip.item).as_deref(), Some("Selects"), "timeline media sits in its bin");
+        assert_eq!((p.item(clip.item).unwrap().name.as_str(), clip.name.as_str()), ("Camera A", "camera.mov"), "renamed in the panel only");
+        assert_eq!(bin_of(fragment.sequences[0]), Some(p.root.name.clone()), "the sequence stays at the root");
+        let black = p.items.values().find(|i| i.name == "Vídeo negro").unwrap();
+        assert!(matches!(&black.kind, ItemKind::Media(m) if matches!(m.media, filmcraft_project::MediaRef::Generator(filmcraft_media::Generator::BlackVideo))));
+        assert_eq!(bin_of(black.id).as_deref(), Some("Unused"), "bin-only media is imported into its bin");
+        assert!(report.mentions("Reds") && report.mentions("search bin"), "{report:?}");
+        // Media and bins without any sequence still import.
+        let no_sequence = bins_fixture().replace(r#"<Sequence ObjectUID="sequence">"#, r#"<Unused ObjectUID="sequence">"#).replace("</Sequence>", "</Unused>");
+        let (fragment, tree, _) = import(no_sequence.as_bytes(), &ImportOptions::default(), None).unwrap();
+        assert!(fragment.sequences.is_empty() && tree.sequences.is_empty());
+        assert!(fragment.project.items.values().any(|i| i.name == "Camera A" && i.as_media().is_some()));
+        // A project with neither sequences nor project items is still empty.
+        let empty = r#"<PremiereData><Project ObjectID="p"><RootProjectItem ObjectURef="r"/></Project><RootProjectItem ObjectUID="r"/></PremiereData>"#;
+        assert!(matches!(import(empty.as_bytes(), &ImportOptions::default(), None), Err(Error::Empty)));
+    }
+    #[test]
+    fn speed_reads_stored_ratio_not_frame_grid_durations() {
+        let xml = fixture().replace("<PlaybackSpeed>2</PlaybackSpeed>", "<PlaybackSpeed>1</PlaybackSpeed>");
+        let (fragment, tree, _) = import(xml.as_bytes(), &ImportOptions::default(), None).unwrap();
+        assert_eq!(tree.sequences[0].tracks[0].items[0].speed, 1.0);
+        assert_eq!(fragment.project.sequence(fragment.sequences[0]).unwrap().video_tracks[0].items[0].speed, 1.0);
+        assert_eq!(tree.sequences[0].tracks[0].items[0].start, Tick(0));
+        assert_eq!(tree.sequences[0].tracks[0].items[0].end, Tick(3 * TPS));
+        assert_eq!(tree.sequences[0].tracks[0].items[0].source_in, Tick(4 * TPS));
+        assert_eq!(tree.sequences[0].tracks[0].items[0].source_out, Tick(10 * TPS));
+    }
+}
diff --git a/crates/interchange/src/premiere_audio.rs b/crates/interchange/src/premiere_audio.rs
new file mode 100644
index 0000000..42eeb3f
--- /dev/null
+++ b/crates/interchange/src/premiere_audio.rs
@@ -0,0 +1,116 @@
+//! Intrinsic audio parameter mapping from contributor-authored project XML.
+//! Raw normalized 0.17782794 reads as 0 dB in Premiere; zero represents silence.
+//! Original work, MIT OR Apache-2.0. Temporal handles are explicitly approximate.
+use super::{error, referred, spend, value, warning};
+use crate::xml::child;
+use crate::{Report, Result};
+use filmcraft_project::{Keyframe, Param, ParamValue};
+use filmcraft_time::Tick;
+use roxmltree::Node;
+use std::collections::BTreeMap;
+
+fn level(raw: &str) -> Result<ParamValue> {
+    let n: f64 = raw.trim().parse().map_err(|_| error("invalid intrinsic audio level"))?;
+    if !n.is_finite() || !(0.0..=1.0).contains(&n) {
+        return Err(error("intrinsic audio level outside normalized bounds"));
+    }
+    Ok(ParamValue::Float(if n == 0.0 { -287.5 } else { (20.0 * n.log10() + 15.0).max(-287.5) }))
+}
+
+/// `match_name` is the caller's (`MatchName`, else `FilterMatchName`), so both agree on which
+/// control this component is.
+pub(super) fn read<'a, 'i>(
+    component: Node<'a, 'i>,
+    match_name: &str,
+    ids: &BTreeMap<&str, Node<'a, 'i>>,
+    work: &mut usize,
+    out: &mut BTreeMap<String, Param>,
+    report: &mut Report,
+) -> Result<()> {
+    // Parameters are matched by their `Param@Index`: `Name` is localised (a Spanish Premiere
+    // writes Nivel / Izquierda / Derecha) while the index layout is not. Volume is Mute (0),
+    // Level (1); Channel Volume is Bypass (0), Left (1), Right (2).
+    let volume = match_name.starts_with("Internal Volume");
+    for ptr in component.descendants().filter(|n| n.has_tag_name("Param")) {
+        let Some(p) = referred(Some(ptr), ids, "ObjectRef") else { continue };
+        spend(work, p)?;
+        let key = match (volume, ptr.attribute("Index")) {
+            (true, Some("1")) => "volume.level",
+            (false, Some("1")) => "channel_volume.left",
+            (false, Some("2")) => "channel_volume.right",
+            (_, Some("0")) => {
+                if value(p, "CurrentValue").is_some_and(|v| v == "1" || v.eq_ignore_ascii_case("true")) || value(p, "Keyframes").is_some() {
+                    warning(report, "intrinsic audio mute/bypass automation retained in provenance, not imported");
+                }
+                continue;
+            }
+            _ => continue,
+        };
+        let Some(raw) = value(p, "CurrentValue").or_else(|| value(p, "StartKeyframe").and_then(|v| v.split(',').nth(1))) else { continue };
+        let mut param = Param::new(level(raw)?);
+        if let Some(keys) = value(p, "Keyframes") {
+            for entry in keys.split(';').filter(|s| !s.trim().is_empty()) {
+                if param.keyframes.len() >= 10000 {
+                    return Err(error("too many intrinsic audio keyframes"));
+                }
+                let mut fields = entry.split(',');
+                let time: i64 =
+                    fields.next().ok_or_else(|| error("audio keyframe without time"))?.trim().parse().map_err(|_| error("invalid audio keyframe tick"))?;
+                if !(0..=Tick::MAX.0).contains(&time) {
+                    return Err(error("audio keyframe outside tick bounds"));
+                }
+                let val = level(fields.next().ok_or_else(|| error("audio keyframe without value"))?)?;
+                param.keyframes.push(Keyframe::new(Tick(time), val));
+            }
+            // FilmCraft cannot express Premiere's native amplitude/ease handles exactly.
+            // Keep exact source-time control points and warn rather than imply sound parity.
+            if !param.keyframes.is_empty() {
+                warning(report, "intrinsic audio keyframe values/times imported; interpolation approximated with linear dB segments");
+            }
+            param.keyframes.sort_by_key(|k| k.time);
+            if param.keyframes.windows(2).any(|p| p[0].time == p[1].time) {
+                return Err(error("duplicate intrinsic audio keyframe time"));
+            }
+        }
+        out.insert(key.to_string(), param);
+    }
+    Ok(())
+}
+
+fn is_true(v: &str) -> bool {
+    v == "1" || v.eq_ignore_ascii_case("true")
+}
+
+/// Whether an audio track is muted on its mixer fader: `AudioTrack/ComponentOwner` points to the
+/// track's component chain, whose `AudioFader` holds Volume (`Param@Index` 0) and Mute (1). Read
+/// by index because the parameter `Name` is localised. Mute automation is not imported: the
+/// value at the start of the sequence is used and a warning says so.
+pub(super) fn fader_muted<'a, 'i>(
+    track: Node<'a, 'i>,
+    ids: &BTreeMap<&str, Node<'a, 'i>>,
+    work: &mut usize,
+    report: &mut Report,
+    context: &str,
+) -> Result<bool> {
+    let owner = child(track, "AudioTrack").and_then(|t| child(t, "ComponentOwner")).and_then(|o| child(o, "Components"));
+    let Some(chain) = referred(owner, ids, "ObjectRef") else { return Ok(false) };
+    spend(work, chain)?;
+    let components = child(chain, "ComponentChain").and_then(|c| child(c, "Components")).or_else(|| child(chain, "Components"));
+    let fader = components
+        .into_iter()
+        .flat_map(|c| c.children())
+        .filter(|c| c.has_tag_name("Component"))
+        .filter_map(|c| referred(Some(c), ids, "ObjectRef"))
+        .find(|c| c.has_tag_name("AudioFader"));
+    let Some(fader) = fader else { return Ok(false) };
+    spend(work, fader)?;
+    let pointer = fader.descendants().find(|n| n.has_tag_name("Param") && n.attribute("Index") == Some("1"));
+    let Some(mute) = referred(pointer, ids, "ObjectRef") else { return Ok(false) };
+    spend(work, mute)?;
+    let start = value(mute, "StartKeyframe").and_then(|k| k.split(',').nth(1)).map(str::trim);
+    let muted = value(mute, "CurrentValue").or(start).is_some_and(is_true);
+    if value(mute, "Keyframes").is_some_and(|k| !k.trim().is_empty()) {
+        warning(report, format!("{context}: track mute automation retained in provenance, not imported; the starting value is used"));
+    }
+    Ok(muted)
+}
diff --git a/crates/interchange/src/premiere_color.rs b/crates/interchange/src/premiere_color.rs
new file mode 100644
index 0000000..790e730
--- /dev/null
+++ b/crates/interchange/src/premiere_color.rs
@@ -0,0 +1,111 @@
+//! Bounded scalar Lumetri mapping observed in contributor-owned project XML.
+//! Existing PR #1694 informed matching effects to FilmCraft's registry, but its
+//! optional-control-type/name matching cannot map these files. Stable IDs avoid
+//! duplicate labels and work when ParameterControlType is omitted. Original work.
+use super::{error, referred, spend, static_parameter_value, value, warning};
+use crate::xml::child_text;
+use crate::{Report, Result};
+use filmcraft_project::{EffectInstance, Keyframe, Param, ParamKind, ParamValue, find_effect};
+use filmcraft_time::Tick;
+use roxmltree::Node;
+use std::collections::{BTreeMap, BTreeSet};
+
+fn mapped(id: &str) -> Option<&'static str> {
+    Some(match id {
+        "3" => "basic_on",
+        "7" => "temperature",
+        "8" => "tint",
+        "11" => "exposure",
+        "12" => "contrast",
+        "13" => "highlights",
+        "14" => "shadows",
+        "15" => "whites",
+        "16" => "blacks",
+        "20" => "saturation",
+        "23" => "creative_on",
+        "26" => "look_intensity",
+        "28" => "faded_film",
+        "29" => "sharpen",
+        "30" => "vibrance",
+        "31" => "creative_sat",
+        "37" => "curves_on",
+        "46" => "wheels_on",
+        "50" => "vignette_on",
+        "51" => "vignette_amount",
+        "52" => "vignette_midpoint",
+        "53" => "vignette_roundness",
+        "54" => "vignette_feather",
+        _ => return None,
+    })
+}
+
+fn convert(raw: &str, kind: &ParamKind, report: &mut Report) -> Result<ParamValue> {
+    match kind {
+        ParamKind::Bool => match raw.trim() {
+            "true" | "1" => Ok(ParamValue::Bool(true)),
+            "false" | "0" => Ok(ParamValue::Bool(false)),
+            _ => Err(error("invalid color switch")),
+        },
+        ParamKind::Float { min, max, .. } => {
+            let v: f64 = raw.trim().parse().map_err(|_| error("invalid color scalar"))?;
+            if !v.is_finite() {
+                return Err(error("non-finite color scalar"));
+            }
+            if v < *min || v > *max {
+                warning(report, "Lumetri scalar exceeds FilmCraft's supported range; clamped");
+            }
+            Ok(ParamValue::Float(v.clamp(*min, *max)))
+        }
+        _ => Err(error("unsupported color parameter kind")),
+    }
+}
+
+pub(super) fn read<'a, 'i>(component: Node<'a, 'i>, ids: &BTreeMap<&str, Node<'a, 'i>>, work: &mut usize, report: &mut Report) -> Result<EffectInstance> {
+    let def = find_effect("lumetri").ok_or_else(|| error("Lumetri effect unavailable"))?;
+    let mut effect = def.instance();
+    effect.enabled = !matches!(value(component, "Bypass"), Some("true" | "1"));
+    let mut seen = BTreeSet::new();
+    for pointer in component.descendants().filter(|n| n.has_tag_name("Param")) {
+        let Some(p) = referred(Some(pointer), ids, "ObjectRef") else { continue };
+        spend(work, p)?;
+        let Some(key) = child_text(p, "ParameterID").and_then(mapped) else { continue };
+        if !seen.insert(key) {
+            return Err(error("duplicate mapped color parameter"));
+        }
+        let Some(pd) = def.params.iter().find(|p| p.id == key) else { continue };
+        let Some(raw) = static_parameter_value(p) else { continue };
+        let mut param = Param::new(convert(raw, &pd.kind, report)?);
+        if let Some(keys) = child_text(p, "Keyframes") {
+            if matches!(pd.kind, ParamKind::Bool) {
+                warning(report, "animated Lumetri section switches unsupported; static value used");
+            } else {
+                for entry in keys.split(';').filter(|e| !e.trim().is_empty()) {
+                    if param.keyframes.len() >= 10000 {
+                        return Err(error("too many color keyframes"));
+                    }
+                    let mut fields = entry.split(',');
+                    let tick: i64 =
+                        fields.next().ok_or_else(|| error("color keyframe missing time"))?.trim().parse().map_err(|_| error("invalid color keyframe time"))?;
+                    if !(0..=Tick::MAX.0).contains(&tick) {
+                        return Err(error("color keyframe outside tick bounds"));
+                    }
+                    let value = convert(fields.next().ok_or_else(|| error("color keyframe missing value"))?, &pd.kind, report)?;
+                    param.keyframes.push(Keyframe::new(Tick(tick), value));
+                }
+                param.keyframes.sort_by_key(|k| k.time);
+                if param.keyframes.windows(2).any(|k| k[0].time == k[1].time) {
+                    return Err(error("duplicate color keyframe time"));
+                }
+                if !param.keyframes.is_empty() {
+                    warning(report, "Lumetri keyframe values/times imported; interpolation approximated with linear segments");
+                }
+            }
+        }
+        effect.params.insert(key.into(), param);
+    }
+    warning(
+        report,
+        "Lumetri scalar controls imported; opaque LUTs, curves, wheels and HSL data retained in provenance, not imported; renderer parity is not guaranteed",
+    );
+    Ok(effect)
+}
diff --git a/crates/interchange/src/premiere_fidelity_tests.rs b/crates/interchange/src/premiere_fidelity_tests.rs
